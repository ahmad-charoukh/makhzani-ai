# Runtime DB and BUCKET bindings are declared in .openai/hosting.json.
# Production identity comes only from the trusted Sites dispatcher.
# Never expose the Worker directly to the internet accepting untrusted identity headers.
# Future provider adapters must consume server-side secrets, never NEXT_PUBLIC keys.
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
